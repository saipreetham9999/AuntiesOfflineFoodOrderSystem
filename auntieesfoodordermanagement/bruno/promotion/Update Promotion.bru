meta {
  name: Update Promotion
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/promotions/{{promotionId}}
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipartForm {
  title: New Summer Deal (Updated)
  description: Get 25% off all cold beverages!
  active: true
  image: @/path/to/your/new_image.jpg // Optional: Replace with the actual path to a new image file
}

headers {
  Content-Type: multipart/form-data
}
