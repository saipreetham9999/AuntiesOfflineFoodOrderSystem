meta {
  name: Create User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "New Admin",
    "email": "newadmin@example.com",
    "password": "password123",
    "role": "ADMIN"
  }
}

headers {
  Content-Type: application/json
}
