meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

body:json {
  {
    "email": "testuser@example.com",
    "otp": "123456" // Replace with the actual OTP received via email
  }
}

headers {
  Content-Type: application/json
}
