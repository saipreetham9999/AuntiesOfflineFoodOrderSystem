meta {
  name: Login User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "testuser@example.com",
    "password": "password123"
  }
}

headers {
  Content-Type: application/json
}

script:post-request {
  if (res.body && res.body.token) {
    bru.setEnvVar('token', res.body.token);
    bru.setEnvVar('userId', res.body.userId); // Assuming userId is also returned
    console.log('JWT Token and userId extracted and set in environment variables.');
  } else {
    console.log('Login failed or token not found in response.');
  }
}
